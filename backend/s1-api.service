[Unit]
Description=S1 API (Mojolicious)
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/s1/backend
ExecStart=/usr/bin/site_perl/hypnotoad -f s1-api.pl
ExecReload=/usr/bin/site_perl/hypnotoad s1-api.pl
Restart=on-failure
User=http

[Install]
WantedBy=multi-user.target
